# Copy this file to .env and adjust if needed.

# Local Postgres from docker-compose.yml (port 5436 avoids clashing with other Postgres instances)
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/finance_tracker"

# Signs the session cookie. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-string"

# The site's public address, used for links in password reset emails.
# Optional locally (defaults to http://localhost:3000); set it in production.
# APP_URL="https://your-app.vercel.app"

# Sending real email (password reset). Without RESEND_API_KEY, emails are printed
# in the terminal running the app instead. Get a free key at https://resend.com
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Finance Tracker <noreply@your-domain.com>"
