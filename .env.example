# Copy this file to .env and adjust if needed.

# Local Postgres from docker-compose.yml (port 5436 avoids clashing with other Postgres instances)
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/finance_tracker"

# Signs the session cookie. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-string"
